{
  "dataset": {
    "name": "RideBase Synthetic Motorcycle Maintenance Dataset",
    "short_name": "RideBase",
    "dataset_version": "1.0.0",
    "status": "V1_FINALIZATION",
    "generated_date": "2026-08-25",
    "language": "tr-TR",
    "currency": "TRY",
    "data_origin": "SYNTHETIC",
    "random_seed": 42,
    "generator_version": "1.0.0",
    "rule_set_version": "1.0.0",
    "scenario_id": "MAINTENANCE_EVENT_SIM_V1",
    "purpose": "Develop and evaluate leakage-aware machine-learning workflows for predicting the timing/kilometres of the next motorcycle service and the canonical maintenance tasks expected at that service."
  },
  "design_principles": [
    "Simulate the causal maintenance process first, then derive relational records.",
    "Motorcycle mileage is longitudinal and must not decrease in the clean simulation backbone.",
    "Maintenance work and parts must respect motorcycle technical compatibility rules.",
    "Synthetic/derived records retain provenance and deterministic generator metadata.",
    "Future service information is kept out of feature snapshots and stored in separate target tables.",
    "Controlled noise and repaired inconsistencies are auditable rather than silently discarded.",
    "Primary evaluation is temporal; additional unseen-motorcycle and unseen-workshop regimes are provided."
  ],
  "prediction_tasks": {
    "next_service": {
      "feature_table": "ml_maintenance_snapshots.parquet",
      "target_table": "ml_next_service_targets.parquet",
      "target_examples": [
        "days_to_next_service",
        "km_to_next_service",
        "target_event_observed",
        "is_right_censored"
      ]
    },
    "next_maintenance_tasks": {
      "feature_table": "ml_maintenance_snapshots.parquet",
      "target_table": "ml_next_task_targets.parquet",
      "target_type": "multi_label_classification",
      "canonical_target_class_count": 81,
      "unknown_label_value_for_right_censoring": -1
    }
  },
  "coverage": {
    "service_received_at_min": "2021-01-27 09:01:00",
    "service_received_at_max": "2026-08-01 17:31:00",
    "entity_counts": {
