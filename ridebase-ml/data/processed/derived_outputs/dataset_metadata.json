  "ml_snapshot_contract": {
    "snapshot_key": "snapshot_id",
    "snapshot_semantics": "Post-service canonical state after the current service has been delivered.",
    "feature_target_join": "snapshot_id",
    "feature_row_count": 41518,
    "next_service_target_row_count": 41518,
