    "additional_regimes": [
      "UNSEEN_MOTORCYCLE",
      "UNSEEN_WORKSHOP"
    ],
    "direct_target_rule": "A next-service/task target is directly eligible in a primary split only when the next event is observed by that split's label cutoff."
  },
