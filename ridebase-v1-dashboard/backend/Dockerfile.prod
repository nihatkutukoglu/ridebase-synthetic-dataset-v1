# Inference-only production image. Build context = repo root.
#   docker build -f ridebase-v1-dashboard/backend/Dockerfile.prod -t ridebase-api .
# Requires ridebase-v1-dashboard/backend/artifacts/ (run scripts/collect_prod_artifacts.sh first)
# OR mount a volume at /artifacts and leave the COPY line's target empty.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ENV=production \
    MODEL_DIR=/artifacts/models \
    REPORTS_DIR=/artifacts/reports \
    OUTPUTS_DIR=/artifacts/outputs \
    DATASET_DIR=/artifacts/dataset \
    MODEL_CATALOG_PATH=/app/app/data/ridebase_motorcycle_models_v1.csv \
    MAINTENANCE_POLICY_PATH=/app/app/data/maintenance_policies.csv \
    V2_1_HISTORY_SOURCE_DIR=/app/app/history_data \
    V2_1_HISTORY_SCHEMA_CONTRACT=/app/app/history_config/source_schema_contract_v1_3.json

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

COPY ridebase-v1-dashboard/backend/requirements-prod.txt .
RUN pip install -r requirements-prod.txt

# V2 inference package (ridebase_ml.v2.V2SurvivalPredictor) — importable via site .pth
COPY ridebase-ml/ridebase_ml /opt/ridebase_ml/ridebase_ml
RUN echo "/opt/ridebase_ml" > "$(python -c 'import site;print(site.getsitepackages()[0])')/ridebase_ml.pth"

COPY ridebase-v1-dashboard/backend/app ./app
RUN mkdir -p /app/app/data
COPY ridebase_v1_3/source_tables/ridebase_motorcycle_models_v1.csv /app/app/data/ridebase_motorcycle_models_v1.csv
COPY ridebase_v1_3/source_tables/maintenance_policies.csv /app/app/data/maintenance_policies.csv
RUN mkdir -p /app/app/history_data /app/app/history_config
COPY ridebase_v1_4/source_tables /app/app/history_data
COPY ridebase-ml/config/source_schema_contract_v1_3.json /app/app/history_config/source_schema_contract_v1_3.json
# curated ~50 MB artifact subset; comment out if mounting a volume at /artifacts
COPY ridebase-v1-dashboard/backend/artifacts /artifacts

# V2.1 dynamic-landmark model bundle
RUN mkdir -p /artifacts/models/v2_1_v1_4
COPY ridebase-ml/models/v2_1_v1_4 /artifacts/models/v2_1_v1_4

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
