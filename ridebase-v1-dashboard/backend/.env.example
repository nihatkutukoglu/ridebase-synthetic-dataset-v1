# RideBase V1 Intelligence - backend environment
# Copy to .env for local runs (docker-compose reads this file).

APP_ENV=development

# Artifact locations. Defaults resolve to ../../ridebase-ml/... relative to the app.
# In Docker they are mounted read-only at /artifacts/*.
MODEL_DIR=../../ridebase-ml/models
REPORTS_DIR=../../ridebase-ml/reports
OUTPUTS_DIR=../../ridebase-ml/outputs
DATASET_DIR=../../ridebase_v1_3/derived_outputs

# Comma-separated list of allowed browser origins for CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Guards
MAX_REQUEST_BYTES=1000000
SCATTER_SAMPLE=1500
